{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noEmit": true
  },
  "include": [
    "apps/demo-merchant/**/*.ts",
    "packages/evidence/**/*.ts",
    "packages/stellar-observer/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
