+import { short } from "./diagnosis.js";
+import type { ResumeResult } from "./resume.js";
+
+const wrap = (text: string, indent: string, width = 92) => {
+  const lines: string[] = []; let line = "";
+  for (const word of text.split(" ")) {
+    if (line && (line + " " + word).length > width - indent.length) { lines.push(line); line = word; } else line = line ? line + " " + word : word;
+  }
+  if (line) lines.push(line);
+  return lines.map((l, i) => (i ? indent : "") + l).join("\n");
+};
+
+const STATUS = { done: "TERMINÉ", "retry-later": "EN ATTENTE — relancer la même commande plus tard est sûr", "needs-human": "BLOQUÉ — décision humaine nécessaire" } as const;
+
+export function formatBilan(r: ResumeResult): string {
+  const rep = r.report, indent = "  ";
+  const paid = rep ? rep.transfers.length + " transfert(s) observé(s) · " + rep.settledAmountAtomic + " / " + rep.expectedAmountAtomic + " unités atomiques" : "non vérifiable (rapport indisponible)";
+  const tx = rep?.transfers[0]?.txHash ?? rep?.observations?.find(o => o.txHash)?.txHash ?? "";
+  const lines = [
+    "ChaosPay — reprise de l'achat « " + r.purchaseId + " »  (" + r.mode + " · " + r.application + ")",
+    "",
+    indent + "Verdict avant  : " + (r.before ? r.before.verdict : r.merchant === "ok" ? "aucun journal côté marchand (jamais reçu)" : "non consulté (marchand injoignable)"),
+    indent + "Verdict après  : " + (rep ? rep.verdict : "indisponible"),
+    indent + "Tentatives     : " + r.attemptsMade + " (autorisation d'origine, aucune re-signature)",
+    indent + "Paiements      : " + paid + (tx ? " · tx " + short(tx) : ""),
+    "",
+    indent + STATUS[r.diagnosis.outcome] + " : " + r.diagnosis.headline,
+    indent + "Pourquoi : " + wrap(r.diagnosis.why, indent + " ".repeat(11)),
+    indent + "Action   : " + wrap(r.diagnosis.action, indent + " ".repeat(11)),
+  ];
+  if (r.requestAssumed) lines.push("", indent + "Note : aucun fichier de requête trouvé ; le corps de démonstration `smoke:payment` a été supposé (sans effet de paiement si faux : le marchand répond 409).");
+  lines.push("", indent + "Données conservées");
+  lines.push(indent + "  autorisation : " + r.files.authorization);
+  if (r.files.request) lines.push(indent + "  requête      : " + r.files.request);
+  if (r.files.result) lines.push(indent + "  résultat     : " + r.files.result);
+  lines.push(indent + "  journal      : " + r.files.journal);
+  return lines.join("\n");
+}
diff --git a/packages/client-recovery/src/local-files.ts b/packages/client-recovery/src/local-files.ts
new file mode 100644
index 0000000..4820aa8
--- /dev/null
+++ b/packages/client-recovery/src/local-files.ts
@@ -0,0 +1,113 @@
+import { mkdirSync, readdirSync, readFileSync, renameSync, statSync, writeFileSync, existsSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { PaymentPayloadV2Schema } from "@x402/core/schemas";
+import type { PaymentPayload } from "@x402/core/types";
+
+export type Mode = "durable" | "naive";
+export type Application = "csv" | "receipt";
+
+/** Données locales absentes, illisibles ou incohérentes : on s'arrête avant tout envoi réseau. */
+export class LocalDataError extends Error {}
+
+export const ID_PATTERN = /^[a-zA-Z0-9_-]{1,80}$/;
+export const DEFAULT_DIR = ".local";
+export const LEGACY_SMOKE_BODY = { rows: [{ item: "demo", amount: 42 }, { item: "second", amount: 10 }] };
+
+export interface LocalRequest { application: Application; merchantUrl: string; path: string; body: unknown; }
+export interface LocalPurchase {
+  id: string; mode: Mode; payload: PaymentPayload; request: LocalRequest;
+  /** true : .local/request-*.json absent, requête reconstruite pour un ancien achat `smoke:payment`. */
+  requestAssumed: boolean;
+  ageMs: number; resultSaved: boolean;
+  files: { authorization: string; request: string; result: string; journal: string };
+}
+export interface LogEntry { at: string; step: string; detail: string; }
+
+export function filePaths(dir: string, mode: Mode, id: string) {
+  const suffix = mode + "-" + id + ".json";
+  return {
+    authorization: join(dir, "client-" + suffix), request: join(dir, "request-" + suffix),
+    result: join(dir, "result-" + suffix), journal: join(dir, "recovery-" + suffix),
+  };
+}
+
+/** Les serveurs de démonstration n'écoutent que sur 127.0.0.1 : l'autorisation signée ne part jamais ailleurs. */
+export function loopbackUrl(raw: unknown, label: string): string {
+  let url: URL;
+  try { url = new URL(String(raw)); } catch { throw new LocalDataError(label + " : URL invalide."); }
+  if (url.protocol !== "http:" || url.hostname !== "127.0.0.1" || url.pathname !== "/" || url.search || url.hash || url.username || url.password)
+    throw new LocalDataError(label + " doit être de la forme http://127.0.0.1:<port> ; l'autorisation n'est jamais envoyée ailleurs.");
+  return url.origin;
+}
+
+function readJson(path: string, label: string): unknown {
+  try { return JSON.parse(readFileSync(path, "utf8")); }
+  catch { throw new LocalDataError(label + " illisible : " + path); }
+}
+
+export function writeJsonAtomic(path: string, value: unknown) {
+  mkdirSync(dirname(path), { recursive: true });
+  const temporary = path + ".tmp-" + process.pid;
+  writeFileSync(temporary, JSON.stringify(value, null, 2) + "\n", { mode: 0o600 });
+  renameSync(temporary, path); // jamais de fichier à moitié écrit : on garde l'ancien ou le nouveau
+}
+
+export function appendLog(dir: string, mode: Mode, id: string, step: string, detail: string, now = new Date()) {
+  const path = filePaths(dir, mode, id).journal;
+  let entries: LogEntry[] = [];
+  try { const old = JSON.parse(readFileSync(path, "utf8")); if (Array.isArray(old)) entries = old as LogEntry[]; } catch { /* premier passage */ }
+  entries.push({ at: now.toISOString(), step, detail });
+  writeJsonAtomic(path, entries.slice(-200));
+}
+
+export function saveResult(dir: string, mode: Mode, id: string, record: Record<string, unknown>) {
+  writeJsonAtomic(filePaths(dir, mode, id).result, record);
+}
+
+export function listPurchases(dir: string, now = Date.now()) {
+  if (!existsSync(dir)) return [];
+  const found: { id: string; mode: Mode; ageMs: number; hasRequest: boolean; resultSaved: boolean }[] = [];
+  for (const name of readdirSync(dir)) {
+    const m = /^client-(durable|naive)-([a-zA-Z0-9_-]{1,80})\.json$/.exec(name);
+    if (!m) continue;
+    const mode = m[1] as Mode, id = m[2]!, paths = filePaths(dir, mode, id);
+    found.push({ id, mode, ageMs: Math.max(0, now - statSync(paths.authorization).mtimeMs), hasRequest: existsSync(paths.request), resultSaved: existsSync(paths.result) });
+  }
+  return found.sort((a, b) => a.ageMs - b.ageMs);
+}
+
+function validateRequest(value: unknown, id: string, mode: Mode): LocalRequest {
+  const r = value as Partial<LocalRequest> | null;
+  if (!r || typeof r !== "object" || !["csv", "receipt"].includes(String(r.application)) || typeof r.path !== "string" || r.body === undefined)
+    throw new LocalDataError("Fichier de requête invalide.");
+  const merchantUrl = loopbackUrl(r.merchantUrl, "merchantUrl");
+  if (r.path !== "/purchases/" + id + "?mode=" + mode)
+    throw new LocalDataError("La requête sauvegardée ne correspond pas à l'achat " + id + " (" + mode + ").");
+  return { application: r.application as Application, merchantUrl, path: r.path, body: r.body };
+}
+
+export function loadPurchase(dir: string, id: string, requestedMode?: Mode, now = Date.now(), env: NodeJS.ProcessEnv = process.env): LocalPurchase {
+  if (!ID_PATTERN.test(id)) throw new LocalDataError("Identifiant d'achat invalide (1 à 80 caractères : lettres, chiffres, - ou _).");
+  const modes: Mode[] = requestedMode ? [requestedMode] : (["durable", "naive"] as const).filter(m => existsSync(filePaths(dir, m, id).authorization));
+  if (!modes.length) throw new LocalDataError("Aucune autorisation sauvegardée pour « " + id + " » dans " + dir + ". Lancez `npm run recover -- --list` pour voir les achats retrouvables.");
+  if (modes.length > 1) throw new LocalDataError("« " + id + " » existe en mode durable et naive : précisez --mode durable ou --mode naive.");
+  const mode = modes[0]!, files = filePaths(dir, mode, id);
+  if (!existsSync(files.authorization)) throw new LocalDataError("Aucune autorisation sauvegardée pour « " + id + " » en mode " + mode + ".");
+  let payload: PaymentPayload;
+  try { payload = PaymentPayloadV2Schema.parse(readJson(files.authorization, "Autorisation")) as unknown as PaymentPayload; }
+  catch (e) { if (e instanceof LocalDataError) throw e; throw new LocalDataError("Autorisation sauvegardée invalide : " + files.authorization); }
+
+  let request: LocalRequest, requestAssumed = false;
+  if (existsSync(files.request)) request = validateRequest(readJson(files.request, "Requête"), id, mode);
+  else {
+    // Anciens achats `smoke:payment` : le corps était fixe. Si l'hypothèse est fausse, le marchand répond 409 avant tout paiement.
+    request = { application: "csv", merchantUrl: loopbackUrl(env.MERCHANT_URL ?? "http://127.0.0.1:3001", "MERCHANT_URL"), path: "/purchases/" + id + "?mode=" + mode, body: LEGACY_SMOKE_BODY };
+    requestAssumed = true;
+  }
+  if ((payload as { resource?: { url?: string } }).resource?.url !== request.merchantUrl + request.path)
+    throw new LocalDataError("L'autorisation sauvegardée appartient à une autre URL que « " + request.merchantUrl + request.path + " » ; elle ne sera pas envoyée.");
+  return {
+    id, mode, payload, request, requestAssumed, files,
+    ageMs: Math.max(0, now - statSync(files.authorization).mtimeMs), resultSaved: existsSync(files.result),
+  };
+}
diff --git a/packages/client-recovery/src/resume.ts b/packages/client-recovery/src/resume.ts
new file mode 100644
index 0000000..bdcf3e3
--- /dev/null
+++ b/packages/client-recovery/src/resume.ts
@@ -0,0 +1,125 @@
+import { PaymentPayloadV2Schema } from "@x402/core/schemas";
+import { digest } from "../../evidence/src/index.js";
+import { asEngineReport, diagnose, type Diagnosis, type EngineReport, type FacilitatorProbe, type Facts } from "./diagnosis.js";
+import { appendLog, loadPurchase, loopbackUrl, saveResult, type Application, type Mode } from "./local-files.js";
+
+export interface ResumeOptions {
+  dir: string; id: string; mode?: Mode; facilitatorUrl: string;
+  attempts?: number; intervalMs?: number;
+  fetch?: typeof fetch; sleep?: (ms: number) => Promise<void>; now?: () => number; log?: (line: string) => void;
+}
+export interface ResumeResult {
+  purchaseId: string; mode: Mode; application: Application; requestAssumed: boolean;
+  /** État du marchand au moment de la reprise : si non joignable, `before` et `report` n'ont pas pu être lus. */
+  merchant: Facts["merchant"];
+  diagnosis: Diagnosis; exitCode: 0 | 1 | 2;
+  before: { verdict: string; reason: string } | null;
+  report: EngineReport | null; facilitator: FacilitatorProbe;
+  attemptsMade: number; ageMs: number;
+  files: { authorization: string; request: string | null; result: string | null; journal: string };
+}
+
+interface Reply { status: number; body: unknown; }
+const SERVICE_ID: Record<Application, string> = { csv: "csv", receipt: "receipt" };
+const RETRYABLE = new Set([0, 202, 503]);
+const b64 = (value: unknown) => Buffer.from(JSON.stringify(value)).toString("base64");
+
+async function call(fetchFn: typeof fetch, url: string, init: RequestInit, timeoutMs: number): Promise<Reply | null> {
+  try {
+    const response = await fetchFn(url, { ...init, signal: AbortSignal.timeout(timeoutMs) });
+    return { status: response.status, body: await response.json().catch(() => null) };
+  } catch { return null; } // connexion refusée, coupée ou expirée : aucune réponse
+}
+
+/**
+ * Reprend un achat avec l'autorisation ORIGINALE sauvegardée. Ne signe jamais de nouvelle autorisation :
+ * toute resoumission passe par le journal du marchand, qui ne règle qu'une fois.
+ */
+export async function resumePurchase(o: ResumeOptions): Promise<ResumeResult> {
+  const fetchFn = o.fetch ?? fetch, sleep = o.sleep ?? ((ms: number) => new Promise<void>(r => setTimeout(r, ms)));
+  const now = o.now ?? Date.now, log = o.log ?? (() => {});
+  const maxAttempts = Math.max(1, o.attempts ?? 6), interval = Math.max(0, o.intervalMs ?? 2000);
+  const facilitatorUrl = loopbackUrl(o.facilitatorUrl, "FACILITATOR_URL");
+
+  const local = loadPurchase(o.dir, o.id, o.mode, now());
+  const { mode, payload, request } = local;
+  const merchant = request.merchantUrl;
+  // Le facilitator indexe ses reçus par le digest du payload APRÈS parsing Zod (clés réordonnées, champs inconnus retirés).
+  const authDigest = digest(PaymentPayloadV2Schema.parse(payload));
+  const signature = b64(payload);
+  const note = (step: string, detail: string) => { log(detail); try { appendLog(o.dir, mode, o.id, step, detail, new Date(now())); } catch { /* le journal est un confort, jamais un blocage */ } };
+
+  const getReport = async () => {
+    const r = await call(fetchFn, merchant + "/reports/" + o.id + "?mode=" + mode, {}, 20_000);
+    return r?.status === 200 ? asEngineReport(r.body) : null;
+  };
+  const probeFacilitator = async (): Promise<FacilitatorProbe> => {
+    const r = await call(fetchFn, facilitatorUrl + "/receipts/" + authDigest, {}, 10_000);
+    if (!r) return "unavailable";
+    if (r.status === 404) return "no-receipt";
+    if (r.status !== 200) return "unavailable";
+    const tx = (r.body as { transaction?: unknown } | null)?.transaction;
+    return typeof tx === "string" && tx ? "receipt-with-hash" : "receipt-without-hash";
+  };
+
+  note("start", "Reprise de « " + o.id + " » (" + mode + ", " + request.application + (local.requestAssumed ? ", requête reconstruite" : "") + ") avec l'autorisation d'origine.");
+  const health = await call(fetchFn, merchant + "/health", {}, 3000);
+  let transport: Facts["merchant"] = health?.status === 200 ? "ok" : "unreachable";
+  if (transport === "ok" && (health!.body as { serviceId?: unknown } | null)?.serviceId !== SERVICE_ID[request.application]) transport = "wrong-service";
+  note("probe", transport === "ok" ? "Marchand joignable." : transport === "wrong-service" ? "Un autre service répond à l'adresse enregistrée." : "Marchand injoignable.");
+
+  const first = transport === "ok" ? await getReport() : null;
+  const before = first ? { verdict: first.verdict, reason: first.reason } : null;
+  if (transport === "ok") note("report", first ? "Verdict avant reprise : " + first.verdict + "." : "Le marchand n'a aucun journal pour cet achat.");
+
+  let last: Facts["last"], acknowledged = false, integrityFailure = false, attemptsMade = 0, resultSaved = local.resultSaved;
+  const alreadyDone = first?.verdict === "PASS" && local.resultSaved;
+  if (alreadyDone) note("skip", "Déjà récupéré : résultat sauvegardé et verdict PASS, aucun envoi.");
+
+  for (let i = 1; transport === "ok" && !alreadyDone && i <= maxAttempts; i++) {
+    attemptsMade = i;
+    const reply = await call(fetchFn, merchant + request.path, {
+      method: "POST", body: JSON.stringify(request.body),
+      headers: { "Content-Type": "application/json", "PAYMENT-SIGNATURE": signature, "X-Chaos-Fault": "none" },
+    }, 180_000);
+    last = { status: reply?.status ?? 0 };
+    note("attempt", "Tentative " + i + "/" + maxAttempts + " : " + (reply ? "HTTP " + reply.status : "aucune réponse (connexion coupée)") + ".");
+
+    if (reply?.status === 200) {
+      const body = (reply.body ?? {}) as { result?: unknown; resultHash?: unknown; txHash?: unknown; recovered?: unknown };
+      if (body.result === undefined || digest(body.result) !== body.resultHash) { integrityFailure = true; note("integrity", "Hash du résultat incohérent : pas d'accusé."); break; }
+      // Résultat sauvegardé AVANT l'accusé : si l'accusé échoue ou si le processus s'arrête, rien n'est perdu.
+      saveResult(o.dir, mode, o.id, { purchaseId: o.id, mode, txHash: body.txHash, resultHash: body.resultHash, savedAt: new Date(now()).toISOString(), result: body.result });
+      resultSaved = true;
+      note("result", "Résultat vérifié et sauvegardé.");
+      const ack = await call(fetchFn, merchant + "/purchases/" + o.id + "/ack?mode=" + mode, {
+        method: "POST", body: JSON.stringify({ resultHash: body.resultHash }),
+        headers: { "Content-Type": "application/json", "PAYMENT-SIGNATURE": signature },
+      }, 10_000);
+      note("ack", ack?.status === 200 ? "Accusé reçu par le marchand." : "Accusé non confirmé (" + (ack ? "HTTP " + ack.status : "aucune réponse") + ").");
+      if (ack?.status === 200) { acknowledged = true; break; }
+      last = { status: ack?.status ?? 0 };
+      if (!RETRYABLE.has(last.status)) break;
+    } else if (reply && !RETRYABLE.has(reply.status)) {
+      break; // refus définitif (400, 402, 409...) : réessayer ne changerait rien
+    } else if (reply?.status === 202) {
+      const b = reply.body as { status?: unknown; reason?: unknown } | null;
+      note("pending", "Statut " + String(b?.status ?? "UNKNOWN") + " : " + String(b?.reason ?? "confirmation non disponible") + ".");
+    } // sans réponse ou HTTP 503 : le marchand redémarre peut-être, on réessaie après l'intervalle
+    if (i < maxAttempts) await sleep(interval);
+  }
+
+  const report = transport === "ok" ? await getReport() : null;
+  const facilitator = await probeFacilitator();
+  const diagnosis = diagnose({
+    merchant: transport, facilitator, report, ...(last ? { last } : {}), application: request.application,
+    resultSaved, acknowledged, ...(integrityFailure ? { integrityFailure } : {}), ageMs: local.ageMs,
+  });
+  note("diagnosis", diagnosis.cause + " : " + diagnosis.headline + ".");
+  return {
+    purchaseId: o.id, mode, application: request.application, requestAssumed: local.requestAssumed, merchant: transport, diagnosis,
+    exitCode: diagnosis.outcome === "done" ? 0 : diagnosis.outcome === "retry-later" ? 2 : 1,
+    before, report, facilitator, attemptsMade, ageMs: local.ageMs,
+    files: { authorization: local.files.authorization, request: local.requestAssumed ? null : local.files.request, result: resultSaved ? local.files.result : null, journal: local.files.journal },
+  };
+}
