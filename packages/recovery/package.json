{
  "name": "@chaospay/recovery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Stellar Testnet payment recovery kit",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/recovery/src/index.d.ts",
      "import": "./dist/recovery/src/index.js"
    },
    "./stellar-http": {
      "types": "./dist/recovery/src/stellar-http.d.ts",
      "import": "./dist/recovery/src/stellar-http.js"
    },
    "./evidence": {
      "types": "./dist/evidence/src/index.d.ts",
      "import": "./dist/evidence/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "16.4.1",
    "@x402/core": "2.23.0",
    "@x402/stellar": "2.23.0",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
